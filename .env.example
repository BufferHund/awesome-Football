# 足球应用环境变量配置示例
# 复制此文件为 .env 并修改配置

# 应用端口
PORT=2000

# 环境模式
NODE_ENV=production

# ================================
# SuperAuth 统一认证配置
# ================================

# SuperAuth Gateway URL
# 如果应用和Gateway在同一个Docker网络中，使用服务名
# Docker内网: http://gateway:4000
# 本地开发: http://localhost:4000
GATEWAY_URL=http://gateway:4000

# SuperAuth Portal URL
# 用于Portal重定向模式
# Docker环境: http://localhost (Nginx代理)
# 生产环境: https://auth.yourdomain.com
PORTAL_URL=http://localhost

# ================================
# 使用说明
# ================================
#
# 1. 独立运行（不使用SuperAuth）：
#    - 不需要配置GATEWAY_URL和PORTAL_URL
#    - 应用仍可运行，但认证功能将不可用
#
# 2. 与SuperAuth集成（推荐）：
#    a. 确保SuperAuth已部署并运行
#    b. 创建 superauth-network 网络：
#       docker network create superauth-network
#    c. 修改 docker-compose.yml 加入 superauth-network
#    d. 配置上述环境变量
#    e. 启动应用：docker-compose up -d
#
# 3. 本地开发：
#    - GATEWAY_URL=http://localhost:4000
#    - PORTAL_URL=http://localhost
#    - 运行：npm run dev
#
