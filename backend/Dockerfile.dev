FROM node:20-slim

# 安装OpenSSL和其他必要的系统依赖
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制package文件
COPY package*.json ./

# 安装所有依赖（包括devDependencies）
RUN npm install

# 复制Prisma schema
COPY prisma ./prisma

# 生成Prisma客户端
RUN npx prisma generate

# 复制源代码和配置
COPY src ./src
COPY tsconfig.json ./
COPY .env* ./

# 复制启动脚本
COPY start.sh ./

# 暴露端口
EXPOSE 1999

# 使用改进的启动脚本（包含数据库连接重试和更好的错误处理）
CMD ["sh", "start.sh"]
