generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  shortName   String
  logo        String?
  country     String
  founded     Int?
  stadium     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  players     Player[]
  standings   Standing[]
}

model Player {
  id          Int      @id @default(autoincrement())
  name        String
  position    String
  number      Int?
  nationality String
  age         Int?
  photo       String?
  teamId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id])
}

model Match {
  id          Int      @id @default(autoincrement())
  homeTeamId  Int
  awayTeamId  Int
  homeScore   Int?
  awayScore   Int?
  status      String   // SCHEDULED, LIVE, FINISHED, POSTPONED
  matchDate   DateTime
  venue       String?
  competition String   // 联赛名称：英超、西甲等
  round       String?  // 第几轮
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  events      MatchEvent[]
}

model MatchEvent {
  id          Int      @id @default(autoincrement())
  matchId     Int
  type        String   // GOAL, CARD, SUBSTITUTION
  player      String
  minute      Int
  detail      String?  // 黄牌、红牌、点球等详情
  createdAt   DateTime @default(now())

  match       Match    @relation(fields: [matchId], references: [id])
}

model Standing {
  id          Int      @id @default(autoincrement())
  teamId      Int
  competition String
  position    Int
  played      Int      @default(0)
  won         Int      @default(0)
  drawn       Int      @default(0)
  lost        Int      @default(0)
  goalsFor    Int      @default(0)
  goalsAgainst Int     @default(0)
  goalDiff    Int      @default(0)
  points      Int      @default(0)
  form        String?  // 最近5场：WWDLL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, competition])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  summary     String?
  content     String
  coverImage  String?
  category    String   // 新闻分类：转会、赛事、采访等
  author      String?
  publishDate DateTime @default(now())
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
