{
  "name": "football-app-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android:install": "npm install @capacitor/core @capacitor/android @capacitor/cli @capacitor/app @capacitor/splash-screen @capacitor/status-bar",
    "android:init": "npm run android:install && cap init",
    "android:add": "npm run android:install && cap add android",
    "android:sync": "cap sync",
    "android:copy": "cap copy",
    "android:open": "cap open android",
    "android:build": "npm run android:install && npm run build && cap sync && cap copy android"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "axios": "^1.6.2",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
